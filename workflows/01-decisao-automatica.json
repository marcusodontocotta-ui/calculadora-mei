{
  "name": "Cúpula — Decisão Automática",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cupula-decision",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cupula-api:8080/api/v1/webhook/decision",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "={{ $json.body.title }}"
            },
            {
              "name": "description",
              "value": "={{ $json.body.description }}"
            },
            {
              "name": "priority",
              "value": "={{ $json.body.priority || 5 }}"
            },
            {
              "name": "auto_legal",
              "value": "={{ $json.body.auto_legal || true }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "call-cupula",
      "name": "Chamar Cúpula",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Chamar Cúpula", "type": "main", "index": 0 }]
      ]
    },
    "Chamar Cúpula": {
      "main": [
        [{ "node": "Responder", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {},
  "tags": [{ "name": "cupula" }]
}
