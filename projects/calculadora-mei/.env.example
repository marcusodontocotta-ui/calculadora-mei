# ── Calculadora MEI - variáveis de ambiente (copie para .env e preencha) ──
# NUNCA versione valores reais. Este arquivo contém apenas placeholders.

# Conexão com o PostgreSQL (obrigatória; sem ela o app não inicia)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/BANCO

# Mercado Pago - token de acesso e chave pública (produção/sandbox)
MP_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXX
MP_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXX

# ── Webhook do Mercado Pago (M2) ────────────────────────────────────────────
# Segredo usado para validar a assinatura HMAC-SHA256 (x-signature) dos
# webhooks do Mercado Pago em /api/webhook/mercadopago.
# Comportamento FAIL-CLOSED:
#   - Se NÃO configurado -> o webhook retorna 503 e NÃO processa nada.
#   - Se configurado     -> exige x-signature/x-request-id válidos, senão 401.
# Gere com:  openssl rand -hex 32   (ou python -c "import secrets;print(secrets.token_hex(32))")
MP_WEBHOOK_SECRET=insira_aqui_o_segredo_hex_64_chars

# Intervalo (segundos) da reconciliação automática de pagamentos (default 600)
RECONCILIACAO_INTERVALO_SEG=600

# Segredo administrativo para endpoints /api/admin/* (Bearer)
ADMIN_SECRET=insira_aqui_um_segredo_forte

# Resend - envio de e-mails de redefinição de senha
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
RESEND_FROM=onboarding@resend.dev
