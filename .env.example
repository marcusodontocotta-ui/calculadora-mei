# Cúpula de Gestão Autônoma — Variáveis de Ambiente
# Copie para .env e preencha os valores (nunca versionar a chave real).

# ── API ────────────────────────────────────────
# Chave de autenticação da API (Header X-API-Key). OBRIGATÓRIA em produção.
# Gere uma chave forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
CUPULA_API_KEY=

API_HOST=0.0.0.0
API_PORT=8080

# ── Redis ──────────────────────────────────────
# Senha do Redis (requirepass). OBRIGATÓRIA — sem default fraco. Gere uma forte,
# ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Em Docker (compose), REDIS_URL é montada automaticamente usando REDIS_PASSWORD.
# Rodando localmente sem Docker, preencha a senha manualmente na URL abaixo.
REDIS_PASSWORD=<GERAR_SENHA_FORTE>
REDIS_URL=redis://:<SUA_REDIS_PASSWORD>@localhost:6379/0

# Worker (Redis Streams) — consumidor único por instância/réplica
REDIS_CONSUMER_GROUP=cupula-worker-group
REDIS_CONSUMER_NAME=cupula-worker-1

# ── n8n (Docker) ───────────────────────────────
N8N_USER=admin
# Senha do Basic Auth do n8n. OBRIGATÓRIA — sem default fraco (o compose falha
# se ausente). Gere uma forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(24))"
N8N_PASSWORD=<GERAR_SENHA_FORTE>

# ── AI Providers (opcional — para AI Gateway) ─
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AI...
# ELEVENLABS_API_KEY=...

# ── Persistência durável (M4) ──────────────────
# Diretório onde as decisões/sínteses são gravadas em JSONL (rotação por tamanho).
# CUPULA_DECISIONS_DIR=./decisions

# ── Rate limiting (M3) ─────────────────────────
# Limite por janela deslizante em memória para endpoints de IA/webhooks.
# RATE_LIMIT_MAX_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# ── Banco de dados (opcional neste release) ────
# Se usado, defina a DATABASE_URL completa (sem credencial hardcoded).
# DATABASE_URL=postgresql://usuario:senha@host:5432/cupula_db
